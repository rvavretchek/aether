{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "declaration": false,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "bin/**/*.js",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
